    },
    "NSDesktopFolderUsageDescription" : {
      "comment" : "Privacy - Desktop Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The access is needed in order to allow you to browse and manage the items in this folder with Nimble Commander. This application will not use any of your personal data without your actions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要此访问权限，才能允许你使用 Nimble Commander 浏览和管理此文件夹中的项目。未经你的操作，本应用程序不会使用你的任何个人数据。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimble Commanderでこのフォルダ内の項目を表示・管理するためにアクセスが必要です。ユーザーの操作なしに個人データを使用することはありません。"
          }
        }
      }
    },
